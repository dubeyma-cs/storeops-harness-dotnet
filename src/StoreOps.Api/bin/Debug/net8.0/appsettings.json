{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Activities": {
    "SlaSweepInterval": "00:05:00",
    "EnableBackgroundSlaSweep": true
  },
  "Alerts": {
    "EscalationGracePeriod": "04:00:00",
    "EscalationSweepInterval": "00:05:00",
    "EnableBackgroundEscalationSweep": true
  }
}
