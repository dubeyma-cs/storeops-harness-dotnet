<?xml version="1.0" encoding="utf-8"?>
<!--
  Scopes coverage collection to the StoreOps.Api application assembly so the coverage gate's
  "Overall project" threshold reflects the API under test and not the StoreOps.ArchCheck dev tool.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[StoreOps.Api]*</Include>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
